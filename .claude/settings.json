{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run verificar:funcional*)",
      "Bash(npm run cerebro:comparar)",
      "Bash(npm run cerebro:avaliar)",
      "Bash(npm run grafo:gerar)",
      "Bash(npm audit*)",
      "Bash(npx tsx --test *)",
      "Bash(npx playwright test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env.local)",
      "Write(./.env.local)"
    ]
  },
  "enabledMcpjsonServers": ["playwright"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash|Grep|Glob|PowerShell",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/bloquear-segredos.mjs" }]
      }
    ]
  }
}
