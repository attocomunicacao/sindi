# Copie para .env.local (privado, nunca versionado). Basta UMA chave de provedor de IA; quanto mais provedores, mais respostas gratuitas por dia.
# Todas as chaves ficam só no servidor: nunca use NEXT_PUBLIC nem coloque chave no código, em URL ou nos logs.

# ── Cascata de IA ────────────────────────────────────────────────────────────────────────────────────────────────────
# A SINDI tenta os provedores nesta ordem; quem esgotar o nível gratuito, falhar ou demorar sai da frente em silêncio (o usuário nunca vê "limite atingido").
# Provedor sem chave fica de fora. O Ollama local é sempre o último degrau. Ids: gemini, groq, openrouter, mistral, cloudflare, anthropic, ollama.
SINDI_CASCATA=gemini,groq,openrouter,mistral,cloudflare,anthropic,ollama
# 1 usa o modelo "rápido" de cada provedor em saudações, recusas e encaminhamentos (também liga com GEMINI_MODEL_RAPIDO).
SINDI_NIVEL_RAPIDO=
# Limites conhecidos de cada provedor, para pular antes de tomar o erro (0 desliga). Padrões: groq 30/min e 1000/dia; openrouter 20/min e 50/dia
# (1000/dia depois de comprar US$ 10 de crédito); mistral 60/min; cloudflare 300/min e 300/dia. Ex.: SINDI_LIMITE_DIA_OPENROUTER=1000
SINDI_LIMITE_MINUTO_GROQ=
SINDI_LIMITE_DIA_GROQ=
SINDI_LIMITE_DIA_OPENROUTER=
# Tempo limite de cada chamada aos provedores na nuvem (ms) e de inatividade do fluxo.
SINDI_TIMEOUT_MS=45000
SINDI_INATIVIDADE_MS=30000

# ── Gemini (Google, nível gratuito) ──────────────────────────────────────────────────────────────────────────────────
# Chave gratuita em https://aistudio.google.com/apikey. Só no servidor: nunca use NEXT_PUBLIC nem coloque a chave no código ou nos logs.
# No nível gratuito o Google pode usar o conteúdo das conversas para melhorar seus produtos: a SINDI remove dados pessoais antes de enviar, e quem usa é avisado.
GEMINI_API_KEY=
# Modelo das respostas com fatos (veja os modelos gratuitos e seus limites no AI Studio).
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: modelo para saudação, recusas e encaminhamentos. Vazio usa só o principal.
GEMINI_MODEL_RAPIDO=
# Modelo da busca por significado no cérebro. Trocar reindexa na próxima execução de "npm run cerebro:indexar".
GEMINI_EMBED_MODEL=gemini-embedding-001
# Opcionais, para modelos que gastam o teto de saída "pensando": tokens extras no teto de resposta e orçamento de raciocínio (0 desliga, nos modelos que permitem).
GEMINI_FOLGA_TOKENS=
GEMINI_PENSAMENTO=

# ── Groq (nível gratuito, sem cartão) ────────────────────────────────────────────────────────────────────────────────
# Chave em https://console.groq.com/keys. Não usa as perguntas para treinar. ~30 pedidos/min e ~1.000/dia por modelo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_RAPIDO=openai/gpt-oss-20b

# ── OpenRouter (modelos ":free") ─────────────────────────────────────────────────────────────────────────────────────
# Chave em https://openrouter.ai/keys. 50 pedidos/dia nos modelos gratuitos (1.000 após US$ 10 de crédito). Alguns modelos gratuitos podem usar os dados.
# "openrouter/free" sorteia um modelo gratuito por pedido; para respostas mais estáveis, fixe um modelo terminado em ":free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── Mistral (plano Experiment, gratuito) ─────────────────────────────────────────────────────────────────────────────
# Chave em https://console.mistral.ai/api-keys. No plano gratuito a Mistral pode usar as perguntas para treinar seus modelos.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Cloudflare Workers AI (10.000 "neurons"/dia grátis) ──────────────────────────────────────────────────────────────
# Token com permissão "Workers AI" em https://dash.cloudflare.com/profile/api-tokens e o id da conta (32 caracteres hexadecimais).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_MODEL_RAPIDO=@cf/meta/llama-3.1-8b-instruct

# ── Anthropic (PAGO — desligado) ─────────────────────────────────────────────────────────────────────────────────────
# Só preencha com autorização expressa: cada resposta é cobrada (estimativa em /custos). Sem a chave, a Anthropic não entra na cascata.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Ollama (modelo local de emergência) ──────────────────────────────────────────────────────────────────────────────
# winget install Ollama.Ollama ; ollama pull qwen2.5:3b . Só endereço desta máquina (127.0.0.1/localhost). Vazio: sem modelo local.
# publicar.ps1 liga o Ollama e preenche este valor sozinho.
SINDI_OLLAMA_URL=http://127.0.0.1:11434
SINDI_OLLAMA_MODEL=qwen2.5:3b
# Só processador: o primeiro trecho pode levar dezenas de segundos.
SINDI_OLLAMA_TIMEOUT_MS=120000

# ── Cota de mensagens ────────────────────────────────────────────────────────────────────────────────────────────────
# Protege os limites gratuitos dos provedores. Mensagens por dia (horário de São Paulo); 0 desliga o limite correspondente. Resposta guardada em memória não gasta cota.
# Com a cascata a capacidade somada passa de mil respostas por dia; o teto geral pode subir conforme os provedores configurados.
SINDI_COTA_IP_DIA=20
SINDI_COTA_GLOBAL_DIA=1500
# Pedidos ao chat por minuto, por visitante (0 desliga; avaliações locais usam 0).
SINDI_CHAT_POR_MINUTO=12
# Cabeçalho que traz o IP do visitante. Vazio: repasse assinado da Vercel (SINDI_REPASSE_SEGREDO), depois cf-connecting-ip, x-vercel-forwarded-for, x-real-ip.
SINDI_IP_HEADER=
# Opcional: sal do hash do IP no Redis.
SINDI_COTA_SAL=
# Gerações simultâneas (padrão 4) e pedidos esperando na fila (padrão 40) antes de recusar.
SINDI_CONCORRENCIA=4
SINDI_FILA_MAX=40

# ── Respostas ────────────────────────────────────────────────────────────────────────────────────────────────────────
# Quantas fontes vão ao modelo por pergunta (1 a 4).
SINDI_MAX_FONTES=2
# 0 desliga a memória (só em RAM) de respostas já escritas para a mesma pergunta e as mesmas fontes.
SINDI_CACHE_RESPOSTAS=1
# Validade, em horas (1 a 168), das respostas guardadas na memória. Padrão: 24.
SINDI_CACHE_HORAS=24

# ── Publicação ────────────────────────────────────────────────────────────────────────────────────────────────────
# Origem https pública autorizada a chamar o chat quando há um repasse na frente (definida por scripts/operacao/publicar.ps1).
SINDI_PUBLIC_ORIGIN=
# Token das chamadas de aquecimento do modelo (gerado por scripts/operacao/publicar.ps1), para não entrarem nas métricas públicas de /uso.
SINDI_AQUECIMENTO_TOKEN=
# Segredo que o repasse da Vercel (deployment/vercel-proxy) manda em cada pedido; só com ele o IP informado pelo repasse vale. Gerado por publicar.ps1.
SINDI_REPASSE_SEGREDO=
# Opcional localmente; necessário na Vercel para métricas persistentes e para a cota de mensagens compartilhada entre processos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Base documental antiga (espelho do site) ──────────────────────────────────────────────────────────────────────
# Apenas no servidor/coletor; a Secret key nunca vai ao navegador. O chat usa a coleta local em SQLite; o espelho só entra se ela não existir.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Calculadora oficial da Receita Federal (RTC, CBS/IBS) ─────────────────────────────────────────────────────────────
# Serviço local (calculadora-rtc-regime-regular, MIT): scripts/operacao/rtc-instalar.ps1 e rtc-subir.ps1. Só endereço desta máquina; vazio = só a calculadora do SINDI.
SINDI_RTC_REGIME_URL=
# Simples Nacional (calculadora-rtc-simples-nacional, MIT), porta 8082 no rtc-subir.ps1. Mesma regra: só endereço desta máquina; vazio = só a calculadora do SINDI.
SINDI_RTC_SIMPLES_URL=
