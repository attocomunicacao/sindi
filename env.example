# Copie para .env.local (privado, nunca versionado). Todos os valores são opcionais: sem este arquivo a SINDI usa os padrões abaixo.

# ── Modelo local (Ollama) ─────────────────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo da SINDI, criado por "npm run modelo:criar" a partir de qwen2.5:1.5b. Para comparar com um modelo maior: qwen2.5:3b.
OLLAMA_MODEL=sindi
OLLAMA_EMBED_MODEL=nomic-embed-text
# Somente para uma futura conexão remota protegida; o Ollama não valida este token sozinho. Nunca expor o Ollama diretamente.
OLLAMA_ACCESS_TOKEN=

# ── Consumo do computador ─────────────────────────────────────────────────────────────────────────────────────────
# Threads do modelo. Padrão: núcleos lógicos menos 4 (mínimo 2), para o computador continuar utilizável durante a resposta.
SINDI_NUM_THREAD=
# Janela de contexto em tokens. 4096 cabe regras, exemplos, fontes e duas trocas de histórico.
SINDI_NUM_CTX=4096
# Tempo que o modelo fica na memória depois da última pergunta (cerca de 1,2 GB). Menor = libera a memória antes; a pergunta seguinte espera a recarga (2 a 4 s).
SINDI_KEEP_ALIVE=20m
# Quantas fontes vão ao modelo por pergunta (1 a 4). Mais fontes = leitura mais lenta e mais risco de o modelo pequeno misturá-las.
SINDI_MAX_FONTES=2
# 0 desliga a memória (só em RAM) de respostas já escritas para a mesma pergunta e as mesmas fontes.
SINDI_CACHE_RESPOSTAS=1

# ── Publicação ────────────────────────────────────────────────────────────────────────────────────────────────────
# Origem https pública autorizada a chamar o chat quando há um repasse na frente (definida por scripts/operacao/publicar.ps1).
SINDI_PUBLIC_ORIGIN=
# Opcional localmente; necessário para métricas persistentes na Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Base documental antiga (espelho do site) ──────────────────────────────────────────────────────────────────────
# Apenas no servidor/coletor; a Secret key nunca vai ao navegador. O chat usa a coleta local em SQLite; o espelho só entra se ela não existir.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
