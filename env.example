# Copie para .env.local (privado, nunca versionado). Só GEMINI_API_KEY é obrigatória; o resto tem padrão.

# ── Serviço de IA (Gemini, nível gratuito) ───────────────────────────────────────────────────────────────────────────
# Chave gratuita em https://aistudio.google.com/apikey. Só no servidor: nunca use NEXT_PUBLIC nem coloque a chave no código ou nos logs.
# No nível gratuito o Google pode usar o conteúdo das conversas para melhorar seus produtos: a SINDI remove dados pessoais antes de enviar, e quem usa é avisado.
GEMINI_API_KEY=
# Modelo das respostas com fatos (veja os modelos gratuitos e seus limites no AI Studio).
GEMINI_MODEL=gemini-3.5-flash-lite
# Opcional: modelo para saudação, recusas e encaminhamentos. Vazio usa só o principal.
GEMINI_MODEL_RAPIDO=
# Modelo da busca por significado no cérebro. Trocar reindexa na próxima execução de "npm run cerebro:indexar".
GEMINI_EMBED_MODEL=gemini-embedding-001
# Opcionais, para modelos que gastam o teto de saída "pensando": tokens extras no teto de resposta e orçamento de raciocínio (0 desliga, nos modelos que permitem).
GEMINI_FOLGA_TOKENS=
GEMINI_PENSAMENTO=

# ── Cota de mensagens ────────────────────────────────────────────────────────────────────────────────────────────────
# Protege o limite gratuito do provedor. Mensagens por dia (horário de São Paulo); 0 desliga o limite correspondente. Resposta guardada em memória não gasta cota.
SINDI_COTA_IP_DIA=20
SINDI_COTA_GLOBAL_DIA=300
# Cabeçalho que traz o IP do visitante. Vazio: o primeiro entre x-vercel-forwarded-for, x-real-ip e cf-connecting-ip. Confirme qual chega certo atrás da Vercel e do túnel.
SINDI_IP_HEADER=
# Opcional: sal do hash do IP no Redis.
SINDI_COTA_SAL=
# Gerações simultâneas (padrão 4) e pedidos esperando na fila (padrão 40) antes de recusar.
SINDI_CONCORRENCIA=4
SINDI_FILA_MAX=40

# ── Respostas ────────────────────────────────────────────────────────────────────────────────────────────────────────
# Quantas fontes vão ao modelo por pergunta (1 a 4).
SINDI_MAX_FONTES=2
# 0 desliga a memória (só em RAM) de respostas já escritas para a mesma pergunta e as mesmas fontes.
SINDI_CACHE_RESPOSTAS=1
# Validade, em horas (1 a 168), das respostas guardadas na memória. Padrão: 24.
SINDI_CACHE_HORAS=24

# ── Publicação ────────────────────────────────────────────────────────────────────────────────────────────────────
# Origem https pública autorizada a chamar o chat quando há um repasse na frente (definida por scripts/operacao/publicar.ps1).
SINDI_PUBLIC_ORIGIN=
# Token das chamadas de aquecimento do modelo (gerado por scripts/operacao/publicar.ps1), para não entrarem nas métricas públicas de /uso.
SINDI_AQUECIMENTO_TOKEN=
# Opcional localmente; necessário na Vercel para métricas persistentes e para a cota de mensagens compartilhada entre processos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Base documental antiga (espelho do site) ──────────────────────────────────────────────────────────────────────
# Apenas no servidor/coletor; a Secret key nunca vai ao navegador. O chat usa a coleta local em SQLite; o espelho só entra se ela não existir.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
