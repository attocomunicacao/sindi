{
  "name": "sindi",
  "version": "1.0.0",
  "description": "Assistente do SINDEPRESTEM",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "formatar": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"e2e/**/*.ts\"",
    "formatar:verificar": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"e2e/**/*.ts\"",
    "test": "tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "knowledge:sync": "tsx scripts/knowledge-sync.ts",
    "grafo:gerar": "tsx scripts/cerebro/gerar-grafo.ts",
    "knowledge:watch": "tsx scripts/knowledge-sync.ts --watch",
    "dados:sync": "tsx scripts/dados/dados-sync.ts",
    "dados:watch": "tsx scripts/dados/dados-sync.ts --watch",
    "cerebro:gerar": "tsx scripts/cerebro/gerar-cerebro.ts",
    "cerebro:avaliar": "tsx scripts/cerebro/avaliar-cerebro.ts",
    "cerebro:indexar": "tsx scripts/cerebro/indexar-cerebro.ts",
    "cerebro:comparar": "tsx scripts/cerebro/comparar-busca.ts",
    "cerebro:cobertura": "tsx scripts/cerebro/cobertura-do-cerebro.ts",
    "fontes:fiscalizar": "tsx scripts/cerebro/fiscalizar-fontes.ts",
    "rtc:conferir": "tsx scripts/rtc/conferir-tudo.ts",
    "rtc:conferir:regime": "tsx scripts/rtc/conferir.ts",
    "rtc:conferir:simples": "tsx scripts/rtc/conferir-simples.ts",
    "rtc:catalogo": "tsx scripts/rtc/conferir-catalogo.ts",
    "rtc:conferir:danfse": "tsx scripts/rtc/conferir-danfse.ts",
    "avaliar:treino": "tsx scripts/avaliacao/avaliar-treino.ts",
    "test:coverage": "tsx --test --experimental-test-coverage \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "verificar:funcional": "tsx scripts/operacao/verificar-funcional.ts",
    "test:e2e": "npm run build && playwright test",
    "test:ci": "tsx --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include=\"src/**\" \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\""
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "cheerio": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.1",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "robots-parser": "3.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.11.2",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1"
}
